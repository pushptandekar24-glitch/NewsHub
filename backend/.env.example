# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.  `.env` is git-ignored.
# NEVER commit real keys.
#
# Every external key below stays on the Spring Boot backend. The React app
# never sees any of them — it only ever talks to http://localhost:8080.
# ---------------------------------------------------------------------------

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/newshub?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# --- Auth ---
# Generate one:  openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ---------------------------------------------------------------------------
# NEWS PROVIDERS
#
# Set BOTH keys to get aggregated results (more articles, better dedupe, and
# automatic fallback when one provider is rate-limited). Setting only one
# works too — the app uses whatever is configured.
# ---------------------------------------------------------------------------

# PROVIDER:  NewsAPI.org
# SIGNUP:    https://newsapi.org/register   (free, no card)
# FREE TIER: 100 req/day, ~24h article delay, development/localhost only
NEWS_API_KEY=your_newsapi_key

# PROVIDER:  GNews.io
# SIGNUP:    https://gnews.io/register
# FREE TIER: 100 req/day, 10 req/min, works from a deployed server
GNEWS_API_KEY=your_gnews_key

# Optional, reserved for a future AI summary provider. Not required to run.
AI_API_KEY=optional_future_ai_key

# --- Tuning ---
# Feeds will not reach further back than this many days.
NEWS_FRESHNESS_DAYS=7

# --- Misc ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional: bootstrap the first ADMIN account on startup ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
